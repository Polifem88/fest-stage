{
  "name": "fest-stage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Интерактивная 3D-планировка Большой сцены театра ФЭСТ (Three.js)",
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host --outDir dist",
